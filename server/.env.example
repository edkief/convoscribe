# Copy to .env for `pnpm dev`; matches docker-compose.yml.
DATABASE_URL=postgres://convoscribe:convoscribe@localhost:5432/convoscribe

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=convoscribe
S3_ACCESS_KEY_ID=convoscribe
S3_SECRET_ACCESS_KEY=convoscribe-secret
S3_FORCE_PATH_STYLE=true

# api-key: one user, authenticated by SYNC_API_KEY (at least 32 characters).
# authz-proxy: users behind authz-proxy, keys resolved through AUTHZ_PROXY_URL.
AUTH_MODE=api-key
SYNC_API_KEY=dev-key-change-me-0123456789abcdef
AUTHZ_PROXY_URL=
# authz-proxy mode: comma-separated roles that make a user an admin, replacing
# the default, role-authz-admin. In api-key mode the one user is the admin.
ADMIN_ROLES=
# authz-proxy mode: where the web app's Sign out goes.
WEB_SIGN_OUT_URL=

# The daily storage clean-up: on (default), dry-run or off.
CLEANUP=

# Optional upstreams offered to signed-in users through /api/ai/v1 (#93): an
# OpenAI-compatible base URL each, its key, and the model devices should use.
# Leave a URL blank to offer nothing for that service.
LLM_UPSTREAM_URL=
LLM_UPSTREAM_KEY=
LLM_MODEL=
# Transcript characters per summary or question call from the web app (#117, #118); default 24000.
LLM_MAX_TRANSCRIPT_CHARS=
ASR_UPSTREAM_URL=
ASR_UPSTREAM_KEY=
ASR_MODEL=
# Optional laya decision service (#101) for talking-point checks: its base URL
# (where /v1/systemone lives, laya-serve 0.4.22 or later), its key, and the
# laya model devices ask for (english or multilingual; blank lets laya pick by
# language). Without it, talking points are checked with the language model.
DECISION_UPSTREAM_URL=
DECISION_UPSTREAM_KEY=
DECISION_MODEL=
