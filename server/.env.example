# Copy to .env for `pnpm dev`; matches docker-compose.yml.
DATABASE_URL=postgres://convoscribe:convoscribe@localhost:5432/convoscribe

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=convoscribe
S3_ACCESS_KEY_ID=convoscribe
S3_SECRET_ACCESS_KEY=convoscribe-secret
S3_FORCE_PATH_STYLE=true

# api-key: one user, authenticated by SYNC_API_KEY (at least 32 characters).
# authz-proxy: users behind authz-proxy, keys resolved through AUTHZ_PROXY_URL.
AUTH_MODE=api-key
SYNC_API_KEY=dev-key-change-me-0123456789abcdef
AUTHZ_PROXY_URL=
# authz-proxy mode: comma-separated roles that make a user an admin, replacing
# the default, role-authz-admin. In api-key mode the one user is the admin.
ADMIN_ROLES=
# authz-proxy mode: where the web app's Sign out goes.
WEB_SIGN_OUT_URL=

# The daily storage clean-up: on (default), dry-run or off.
CLEANUP=
