<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The model downloader fetches ASR, segmentation and embedding
        weights from Hugging Face / GitHub Releases over HTTPS on first
        run (resuming with Range requests, issue #10), and the LLM client
        calls the user's own endpoint. The update check (issue #15) asks
        the GitHub API for the app's releases at most once a day (or when
        the user taps Check for updates) and downloads the APK the user
        chose to install. No other network calls live in the app.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        A model download that loses the network waits for it to come
        back before it resumes (`models.NetworkWaiter`, issue #10).
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Required by `audio.MicAudioSource` (TASK-9). The runtime
        permission is requested by the recording service / setup
        screen; the class itself is a thin wrapper around
        `AudioRecord` and cannot check it.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Foreground-service plumbing (TASK-12). Without
        `FOREGROUND_SERVICE` the OS rejects the start of any
        foreground service; `FOREGROUND_SERVICE_MICROPHONE` is the
        typed permission Android 14+ requires for services that
        use the microphone (the corresponding service must also
        declare `foregroundServiceType="microphone"`).
        `WAKE_LOCK` keeps the CPU alive while a recording loop is
        running, and `POST_NOTIFICATIONS` is the Android 13+
        runtime permission for showing the persistent notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        "Display over other apps", for the floating recording control
        shown in other apps while a session is open (issue #7). A
        special access the user grants in system Settings; without it
        the notification stays the only control. It also lets the
        control's tap bring ConvoScribe forward from the background.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        In-app updates (issue #15): hand a downloaded release APK to the
        system installer (`update.PackageUpdateInstaller`). A special
        access ("Install unknown apps") the user grants in system
        Settings, explained before the first install; the user confirms
        every install on the system prompt.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ConvoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ConvoScribe"
        android:largeHeap="true"
        android:usesCleartextTraffic="true">
        <!--
            libcdsprpc.so is the userspace half of the Hexagon DSP RPC
            driver. The QNN HTP backend loads the *.so Skel/Stub pair via
            this library, so on a device without it we cannot create the
            NPU backend. Marking it required="false" lets the APK still
            install on devices/emulators that lack the DSP; QNN device
            creation will fail with error 14001 at runtime if so.
        -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Import an audio file as a session (issue #3): "Share to
                ConvoScribe" from another app, and "Open with" from a
                file manager. `application/ogg` is what many file
                managers call .ogg / .opus voice notes.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>
        <!--
            Starts a recording for the Quick Settings tile (issue #7):
            an activity the user launched makes the app visible, which
            Android 14+ requires before a microphone foreground service
            may start. Invisible, own task, never in Recents.
        -->
        <activity
            android:name=".RecordTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!--
            Foreground recording service (TASK-12). `exported` is
            `false` because the only legitimate caller is our own
            app code, via the typed `start` / `stop` PendingIntents
            (the stop PendingIntent goes through `getService` and
            is therefore scoped to this UID). The
            `foregroundServiceType="microphone"` is mandatory
            starting Android 14 — without it the OS will refuse to
            keep the service in the foreground while the mic is
            hot.
        -->
        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />
        <!--
            Model downloads (issue #10): a `dataSync` foreground service
            so a first-run download survives the screen turning off or
            the user switching apps. Its own notification, separate from
            the recording service. Not exported: started by the setup
            screen and the notification's Cancel action only.
        -->
        <service
            android:name=".service.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!--
            App update downloads (issue #15): the same `dataSync`
            foreground service pattern as the model download, with its own
            notification. Not exported: started by the Update tap and the
            notification's Cancel action only.
        -->
        <service
            android:name=".service.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!--
            Result of an update's install session (issue #15): shows the
            system's confirmation prompt and reports failures. Not
            exported: only the session's PendingIntent reaches it.
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
        <!--
            After an update (issue #15): deletes the installed APK and
            posts "Updated to X.Y.Z, tap to open", since Android does not
            let the app reopen itself. Not exported: the system still
            delivers MY_PACKAGE_REPLACED, which it sends to the updated
            app only.
        -->
        <receiver
            android:name=".update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
            "ConvoScribe" Quick Settings tile (issue #7): start a
            recording from anywhere, pause / resume an open one. Exported
            for System UI only, through the bind permission.
        -->
        <service
            android:name=".service.RecordTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!--
            NPU probe for the engine check. Runs in its own process
            because sherpa-onnx's QNN backend calls exit() when it
            cannot create the HTP device (e.g. the Boox Note Air 6C,
            whose SoC has the NSP fused off); in-process that closes the
            whole app. Here only `:npuprobe` dies and the engine check
            reports why. Bound-only, never exported.
        -->
        <service
            android:name=".service.NpuProbeService"
            android:exported="false"
            android:process=":npuprobe" />
        <!--
            Serves the M4A exports in `cacheDir/exports/` to the share
            sheet (Share audio). Not exported: access is only through
            the one-off read grant on the share intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>