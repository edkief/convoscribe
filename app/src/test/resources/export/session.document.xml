<w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">[00:00] Élodie: </w:t></w:r><w:r><w:t xml:space="preserve">Bonjour à tous, on commence par le budget.</w:t></w:r></w:p>
