<w:p><w:r><w:t xml:space="preserve">Dix pour cent (</w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">10 %</w:t></w:r><w:r><w:t xml:space="preserve">).</w:t></w:r></w:p>
